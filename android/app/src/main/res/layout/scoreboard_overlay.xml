<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="vertical"
    android:background="#CC000000">

    <!-- TOP RIBBON -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="14dp">

        <TextView
            android:id="@+id/tv_venue_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:text="VENUE"
            android:textSize="7sp"
            android:textColor="#8AFFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_match_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:gravity="center"
            android:text="MATCH NAME"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#B3FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_break"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:text="Break : 0"
            android:textSize="9sp"
            android:textColor="#99FFFFFF" />
    </RelativeLayout>

    <!-- MAIN STRIP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- PLAYER 1 SECTION -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/player1_active_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/circle_green"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_player1_name"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:gravity="center_vertical"
                android:background="#FFD600"
                android:text="PLAYER 1"
                android:textAllCaps="true"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- FRAMES -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="6dp">

                <TextView
                    android:text="FRAMES"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player1_frames"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#64B5F6"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SCORE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="6dp">

                <TextView
                    android:text="SCORE"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player1_score"
                    android:text="0"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- HIGH BREAK -->
            <LinearLayout
                android:id="@+id/player1_high_break_container"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:visibility="gone">

                <TextView
                    android:text="HIGH"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player1_high_break"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#FFA726"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CURRENT BREAK -->
            <LinearLayout
                android:id="@+id/player1_current_break_container"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:visibility="gone">

                <TextView
                    android:text="BREAK"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player1_current_break"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#2ECC71"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CENTER FRAME -->
        <TextView
            android:id="@+id/tv_frame_info"
            android:layout_width="80dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:background="#1976D2"
            android:text="2 (5) 3"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- PLAYER 2 SECTION -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <!-- CURRENT BREAK -->
            <LinearLayout
                android:id="@+id/player2_current_break_container"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:text="BREAK"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player2_current_break"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#2ECC71"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- HIGH BREAK -->
            <LinearLayout
                android:id="@+id/player2_high_break_container"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:text="HIGH"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player2_high_break"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#FFA726"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SCORE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <TextView
                    android:text="SCORE"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player2_score"
                    android:text="0"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- FRAMES -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <TextView
                    android:text="FRAMES"
                    android:textSize="6sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player2_frames"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#64B5F6"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_player2_name"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical|end"
                android:background="#FFD600"
                android:text="PLAYER 2"
                android:textAllCaps="true"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <View
                android:id="@+id/player2_active_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/circle_green"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
